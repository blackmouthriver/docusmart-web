{
  "id": "/app/",
  "name": "DocuSmart Web",
  "short_name": "DocuSmart",
  "description": "Herramientas para tus documentos que funcionan en el navegador, sin subir tus archivos: PDF, imágenes, QR y modo estudio.",
  "lang": "es",
  "dir": "ltr",
  "start_url": "/app/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#F7F7F5",
  "theme_color": "#0B1020",
  "categories": ["productivity", "utilities", "education"],
  "icons": [
    { "src": "/img/pwa/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/img/pwa/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/img/pwa/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/img/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Unir PDF", "url": "/app/#/pdf/unir", "icons": [{ "src": "/img/pwa/icon-192.png", "sizes": "192x192" }] },
    { "name": "Convertir", "url": "/app/#/convertir", "icons": [{ "src": "/img/pwa/icon-192.png", "sizes": "192x192" }] },
    { "name": "Códigos QR", "url": "/app/#/qr", "icons": [{ "src": "/img/pwa/icon-192.png", "sizes": "192x192" }] },
    { "name": "Modo Estudio", "url": "/app/#/estudio", "icons": [{ "src": "/img/pwa/icon-192.png", "sizes": "192x192" }] }
  ]
}
