# Configuración web de Firebase (proyecto de la app: docusmart-8904e).
# Cópialo como .env.local y completa los valores de la app web registrada en
# Firebase Console → Configuración del proyecto → Tus apps → Web.
# Sin estos valores la analítica simplemente no se carga (el sitio funciona igual).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=docusmart-8904e.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=docusmart-8904e
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Enlace de la ficha en Google Play
VITE_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.docsmart
