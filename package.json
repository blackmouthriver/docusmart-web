{
  "name": "docusmart-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Landing y versión web de DocuSmart. Todo el procesamiento ocurre en el navegador.",
  "scripts": {
    "predev": "node scripts/copy-wasm-assets.mjs && npm run pages",
    "dev": "vite",
    "prebuild": "node scripts/copy-wasm-assets.mjs && npm run pages",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "audit": "npm audit --omit=dev --audit-level=high",
    "pages": "node scripts/generate-tool-pages.mjs",
    "pages:check": "node scripts/generate-tool-pages.mjs --check",
    "test:e2e": "playwright test"
  },
  "dependencies": {
